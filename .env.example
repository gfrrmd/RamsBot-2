# ═══════════════════════════════════════════════════════════════
#  RamsBot — contoh environment variables untuk Railway
#  Railway → pilih service bot → tab "Variables" → "Raw Editor"
#  → tempel isi file ini (setelah diisi), lalu Update Variables.
#  JANGAN commit file .env asli / jangan bagikan token ke siapa pun.
# ═══════════════════════════════════════════════════════════════

# ── WAJIB ──────────────────────────────────────────────────────
# Token bot dari @BotFather
BOT_TOKEN=123456789:AAH_ganti_dengan_token_botmu
# ID Telegram admin (angka). Cek lewat @userinfobot
ADMIN_ID=123456789
# API ID & API Hash dari https://my.telegram.org  (API development tools)
API_ID=1234567
API_HASH=0123456789abcdef0123456789abcdef
# Connection string PostgreSQL.
# Di Railway: JANGAN diketik manual. Tambahkan plugin PostgreSQL, lalu di
# Variables service bot buat variabel DATABASE_URL dengan nilai referensi:
#   ${{Postgres.DATABASE_URL}}
# (ganti "Postgres" bila nama service database kamu berbeda)
DATABASE_URL=${{Postgres.DATABASE_URL}}

# ── OPSIONAL ───────────────────────────────────────────────────
# ID channel log admin. 0 = nonaktif
LOG_CHANNEL_ID=0
# ID channel tujuan auto backup (selain PM admin). 0 = hanya ke PM admin.
# Bisa juga diatur dari menu admin di bot.
BACKUP_CHANNEL_ID=0
# JSON array ID channel yang diblokir. Contoh: [-1001234567890, -1009876543210]
RESTRICTED_CHANNELS=[]
# Kontak admin yang tampil ke user
ADMIN_CONTACT=@kqrbit
# Nama bot di header pesan
BOT_NAME=RamsBot
# URL Mini App (tanpa garis miring di akhir), contoh https://ramsbot.vercel.app
# Kosong = tombol Mini App & Console Web disembunyikan
WEBAPP_URL=
